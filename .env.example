# Frontend API base URL.
# Local development on the same machine:
VITE_API_BASE_URL="http://localhost:"

# If the frontend is opened from another device in the same LAN, use your PC's LAN IP:
# VITE_API_BASE_URL="http://"

# If the frontend is deployed behind the same domain with a reverse proxy:
# VITE_API_BASE_URL="/api"
